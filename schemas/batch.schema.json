{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aji/schemas/batch.schema.json",
  "title": "AWS Job Intelligence private batch v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "candidate_id", "status", "generated_at",
    "expires_at", "job_ids", "checksum", "matches_checksum", "scoring_version"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "batch_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "FAILED"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "job_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "matches_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scoring_version": {"const": "1.0"}
  }
}
