{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aji/schemas/profile.schema.json",
  "title": "AWS Job Intelligence verified private profile v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "display_name", "approved_by_holder", "validated_at", "claims"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "contact": {
      "type": "object", "additionalProperties": false,
      "required": ["email", "phone", "location", "links"],
      "properties": {
        "email": {"type": "string", "minLength": 1, "maxLength": 250},
        "phone": {"type": "string", "minLength": 1, "maxLength": 250},
        "location": {"type": "string", "minLength": 1, "maxLength": 250},
        "links": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 250}}
      }
    },
    "approved_by_holder": {"const": true},
    "validated_at": {"type": "string", "format": "date"},
    "claims": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "text", "keywords", "evidence"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "keywords": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["source_document", "reference", "verified_at", "reuse_approved"],
            "properties": {
              "source_document": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "verified_at": {"type": "string", "format": "date"},
              "reuse_approved": {"const": true}
            }
          }
        }
      }
    }
  }
}
